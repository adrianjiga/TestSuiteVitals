{
  "name": "suitevitals",
  "version": "0.0.0",
  "description": "The vital signs of your test suite. A CLI-first, zero-infrastructure tool that retroactively ingests CI artifacts and surfaces flaky tests.",
  "keywords": [
    "flaky-tests",
    "test-analytics",
    "ci",
    "github-actions",
    "junit",
    "playwright",
    "cli"
  ],
  "license": "MIT",
  "author": "Adrian Jiga",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianjiga/TestSuiteVitals.git"
  },
  "bugs": "https://github.com/adrianjiga/TestSuiteVitals/issues",
  "homepage": "https://github.com/adrianjiga/TestSuiteVitals#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "suitevitals": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@mongodb-js/zstd": "^7.0.0",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.1",
    "citty": "^0.2.2",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "p-limit": "^7.3.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
